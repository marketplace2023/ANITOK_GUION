PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
# Tiempo máximo total de la cadena de modelos (Netlify corta a los 60 s)
AI_TOTAL_TIMEOUT_MS=50000

# OpenRouter (respaldo con modelos gratuitos): https://openrouter.ai/keys
# Usa una clave normal (no de gestión) con límite de crédito 0 para usar solo modelos :free
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free

# Opcional: persistencia con Prisma
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/animetok
