PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
# Tiempo máximo total de la cadena de modelos (Netlify corta a los 60 s)
AI_TOTAL_TIMEOUT_MS=50000
# Orden de prioridad por defecto de los servicios de IA (se puede cambiar desde Ajustes en la app)
AI_PROVIDER_ORDER=gemini,nemotron,sensenova,gemma,openrouter
# Tiempo máximo por servicio antes de pasar al siguiente, y pausa si está saturado (ms)
AI_PROVIDER_TIMEOUT_MS=25000
AI_COOLDOWN_MS=180000

# NVIDIA Build (respaldo después de Gemini): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Gemma mediante NVIDIA Build, después de Nemotron (clave independiente)
NVIDIA_GEMMA_API_KEY=
NVIDIA_GEMMA_MODEL=google/gemma-4-31b-it

# OpenRouter (respaldo con modelos gratuitos): https://openrouter.ai/keys
# Usa una clave normal (no de gestión) con límite de crédito 0 para usar solo modelos :free
# SenseNova (compatible con OpenAI): https://token.sensenova.ai
SENSENOVA_API_KEY=
SENSENOVA_MODEL=sensenova-6.8-flash
SENSENOVA_FALLBACK_MODELS=sensenova-6.8-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free

# Opcional: escenas de personajes en YouTube (YouTube Data API v3, gratis: 10 000 unidades/día ≈ 100 búsquedas)
YOUTUBE_API_KEY=
# Opcional: ID del reproductor de Dailymotion (Dailymotion Studio → Players, cuenta gratuita, sin tarjeta)
# para ver los clips dentro de la app. No es secreto. Sin él, cada clip se abre en Dailymotion.
DAILYMOTION_PLAYER_ID=

# Login privado (un solo usuario). Genera los valores con: npm run set-password -w backend
APP_USER=admin
APP_PASSWORD_HASH=
AUTH_SECRET=
SESSION_DAYS=30

# Opcional: persistencia con Prisma
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/animetok
